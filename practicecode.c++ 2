#include <iostream>
using namespace std;


class node {
public:
    int data;
    node* next;
    node(int x) {
        data = x;
        next = nullptr;
    }
};


class STACK {
private:
    node* TOS;   
public:
    STACK() {
        TOS = nullptr;
    }
    void push(int value) {
        node* p = new node(value);
        if (p == nullptr) {
            cout << "stack overflow";
            return;
        }
        p->next = TOS;
        TOS = p;
    }

    int pop() {
        if (TOS == nullptr) {
            cout << "Stack Underflow";
            return -1;
        }
        int x = TOS->data;
        node* temp = TOS;
        TOS = TOS->next;
        delete temp;
        return x;
    }

    void display() {
        if (TOS == nullptr) {
            cout << "Stack is empty";
            return;
        }
        node* p = TOS;
        while (p != nullptr) {
            cout << p->data << " -> ";
            p = p->next;
        }
        cout << "NULL";
    }
};

int main() {
    STACK s;

    s.push(10);
    s.push(20);
    s.push(30);
    s.push(40);

    cout << "Stack elements:\n";
    s.display();

    cout << "\n\nPopped element: " << s.pop();

    cout << "\n\nStack after pop:\n";
    s.display();

    return 0;
}
 #include <iostream>
using namespace std;

class Node {
public:
    int data;
    Node* next;

    Node(int val) {
        data = val;
        next = NULL;
    }
};

class LinkedList {
private:
    Node* head;

public:
    LinkedList() {
        head = NULL;
    }

    // Insert at end (helper)
    void insertEnd(int val) {
        Node* newNode = new Node(val);

        if (head == NULL) {
            head = newNode;
            return;
        }

        Node* temp = head;
        while (temp->next != NULL)
            temp = temp->next;

        temp->next = newNode;
    }

    // Display list
    void display() {
        Node* temp = head;
        while (temp != NULL) {
            cout << temp->data << " -> ";
            temp = temp->next;
        }
        cout << "NULL\n";
    }

    // 🔹 Insert BEFORE a given value
    void insertBefore(int target, int val) {
        Node* newNode = new Node(val);

        // Case 1: Empty list
        if (head == NULL) {
            cout << "List is empty\n";
            return;
        }

        // Case 2: Insert before head
        if (head->data == target) {
            newNode->next = head;
            head = newNode;
            return;
        }

        Node* prev = NULL;
        Node* curr = head;

        while (curr != NULL && curr->data != target) {
            prev = curr;
            curr = curr->next;
        }

        if (curr == NULL) {
            cout << "Target not found\n";
            return;
        }

        prev->next = newNode;
        newNode->next = curr;
    }

    // 🔹 Delete BEFORE a given value
    void deleteBefore(int target) {
        // Case 1: Less than 2 nodes
        if (head == NULL || head->next == NULL) {
            cout << "Not enough nodes\n";
            return;
        }

        // Case 2: Target is at head → no node before it
        if (head->data == target) {
            cout << "No node before target\n";
            return;
        }

        // Case 3: Target is second node → delete head
        if (head->next->data == target) {
            Node* temp = head;
            head = head->next;
            delete temp;
            return;
        }

        Node* prevPrev = NULL;
        Node* prev = head;
        Node* curr = head->next;

        while (curr != NULL && curr->data != target) {
            prevPrev = prev;
            prev = curr;
            curr = curr->next;
        }

        if (curr == NULL) {
            cout << "Target not found\n";
            return;
        }

        // Delete 'prev'
        prevPrev->next = curr;
        delete prev;
    }
};

int main() {
    LinkedList list;

    // Initial list
    list.insertEnd(10);
    list.insertEnd(20);
    list.insertEnd(30);
    list.insertEnd(40);

    cout << "Initial List:\n";
    list.display();

    // Insert before
    cout << "\nInsert 25 before 30:\n";
    list.insertBefore(30, 25);
    list.display();

    // Delete before
    cout << "\nDelete node before 30:\n";
    list.deleteBefore(30);
    list.display();

    return 0;
}
