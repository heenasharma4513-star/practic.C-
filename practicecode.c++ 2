class ListNode{
public:
    int val;
    ListNode* next;
    ListNode(int x):val(x),next(nullptr){}
};

class Solution{
public:
    ListNode* swapPairs(ListNode* head){
        ListNode dummy(0);
        dummy.next=head;
        ListNode* curr=&dummy;

        while(curr->next && curr->next->next){
            ListNode* first=curr->next;
            ListNode* second=curr->next->next;

            first->next=second->next;
            second->next=first;
            curr->next=second;

            curr=first;
        }
        return dummy.next;
    }
};

