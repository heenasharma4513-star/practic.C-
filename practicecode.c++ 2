        for(int i=0;i<2;i++)
            for(int j=0;j<2;j++)
                cin >> a[i][j];
    }

    // Addition
    Matrix operator + (const Matrix &m) {
        Matrix temp;
        for(int i=0;i<2;i++)
            for(int j=0;j<2;j++)
                temp.a[i][j] = a[i][j] + m.a[i][j];
        return temp;
    }

    // Multiplication
    Matrix operator * (const Matrix &m) {
        Matrix temp;
        for(int i=0;i<2;i++)
            for(int j=0;j<2;j++) {
                temp.a[i][j] = 0;
                for(int k=0;k<2;k++)
                    temp.a[i][j] += a[i][k] * m.a[k][j];
            }
        return temp;
    }

    // Output
    friend ostream& operator<<(ostream &out, const Matrix &m) {
        for(int i=0;i<2;i++) {
            for(int j=0;j<2;j++)
                out << m.a[i][j] << " ";
            out << endl;
        }
        return out;
    }
};

