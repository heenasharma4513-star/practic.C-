class BankAccount {
private:
    double balance;

public:
    BankAccount(double b = 0) {
        balance = b;
    }

    // Deposit / Merge accounts
    BankAccount operator + (const BankAccount &acc) {
        return BankAccount(balance + acc.balance);
    }

