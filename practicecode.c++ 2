    Student s;
    int id, found = 0;

    cout << "Enter ID to update: ";
    cin >> id;

    fstream file("student.txt", ios::in | ios::out | ios::binary);

    while (file.read((char*)&s, sizeof(s))) {
        if (s.id == id) {
            cout << "Enter new details:\n";
            s.input();

            int pos = -1 * sizeof(s);
            file.seekp(pos, ios::cur);
            file.write((char*)&s, sizeof(s));

            found = 1;
            break;
        }
    }

    file.close();

    if (!found)
        cout << "Record Not Found\n";
}

